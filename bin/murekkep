#!/usr/bin/env bash
# AI AGENTS Dedicated Writer & Paraphraser Agent: murekkep
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"

if [ $# -eq 0 ]; then
    exec opencode --agent "murekkep" --model "ollama/qwen3-coder:30b"
else
    exec opencode run --agent "murekkep" --model "ollama/qwen3-coder:30b" "$@"
fi
