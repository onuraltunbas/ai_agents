#!/usr/bin/env bash
# AI AGENTS Dedicated Agent Launcher: ironman
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"

if [ $# -eq 0 ]; then
    exec opencode --agent "ironman" --model "ollama/qwen3-coder:30b"
else
    exec opencode run --agent "ironman" --model "ollama/qwen3-coder:30b" "$@"
fi
