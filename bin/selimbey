#!/usr/bin/env bash
# ONUR AI Dedicated Agent Launcher: selimbey
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"

if [ $# -eq 0 ]; then
    exec opencode --agent "selimbey" --model "ollama/qwen3-coder:30b"
else
    exec opencode run --agent "selimbey" --model "ollama/qwen3-coder:30b" "$@"
fi
